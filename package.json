{
  "name": "@jordanlawson/skylight-mcp",
  "version": "0.1.0",
  "description": "Unofficial local MCP server for Skylight Calendar: profiles, chores, routines, rewards, lists, events, meals, photos, devices, frame.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "skylight-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/cli.js dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p tsconfig.worker.json",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build && npm run remote:build",
    "live:smoke": "tsx scripts/live-smoke.ts",
    "dev:server": "tsx src/server.ts",
    "dev:cli": "tsx src/cli.ts",
    "remote:dev": "wrangler dev --env staging",
    "remote:build": "wrangler deploy --dry-run --outdir dist-worker --env staging",
    "remote:deploy:staging": "wrangler deploy --env staging",
    "remote:deploy:production": "wrangler deploy --env production"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.1.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@types/node": "24.0.0",
    "tsx": "4.23.0",
    "typescript": "5.9.2",
    "wrangler": "4.153.0"
  }
}
