// The shared skylight-mcp server (Cloudflare Workers). Deploy with `npm run remote:deploy:staging` or
// `npm run remote:deploy:production`; see README "Use from Claude and ChatGPT on any device".
//
// Nothing secret belongs in this file. Secrets are set per environment with `wrangler secret put <NAME> --env <env>`
// (`skylight-mcp remote setup` puts SKYLIGHT_TOKEN_KEY and ADMIN_TOKEN itself):
//   SKYLIGHT_TOKEN_KEY    32 random bytes, base64: encrypts the server's stored Skylight credential
//   ADMIN_TOKEN           bearer token for /admin/* (kept in the Mac Keychain by `remote setup`)
//   GOOGLE_CLIENT_ID      Google OAuth client (Web application)
//   GOOGLE_CLIENT_SECRET
//   ALLOWED_EMAILS        comma-separated Google accounts allowed to sign in
// For `wrangler dev`, put dummy values in .dev.vars (gitignored).
//
// Bindings and vars are not inherited by environments, so each env repeats them. The KV namespace has no id:
// wrangler 4.142 provisions one automatically on the first deploy of each environment.
//
// Logging: invocation logs are off and query strings are redacted; the Worker logs one line per request with method,
// path, status and duration only (src/remote/worker.ts). Request headers and bodies are never logged.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "skylight-mcp",
  "main": "src/remote/worker.ts",
  "compatibility_date": "2026-09-27",
  // nodejs_compat for library internals; global_fetch_strictly_public is required for CIMD (SSRF protection).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false }
  },
  "durable_objects": {
    "bindings": [{ "name": "SKYLIGHT_ACCOUNT", "class_name": "SkylightAccount" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SkylightAccount"] }],
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  "vars": { "SKYLIGHT_TIMEZONE": "America/New_York" },
  "secrets": { "required": ["SKYLIGHT_TOKEN_KEY", "ADMIN_TOKEN", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "ALLOWED_EMAILS"] },
  "env": {
    "staging": {
      "name": "skylight-mcp-staging",
      "workers_dev": true,
      "preview_urls": false,
      "durable_objects": {
        "bindings": [{ "name": "SKYLIGHT_ACCOUNT", "class_name": "SkylightAccount" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SkylightAccount"] }],
      "kv_namespaces": [{ "binding": "OAUTH_KV" }],
      "vars": { "SKYLIGHT_TIMEZONE": "America/New_York" },
      "secrets": { "required": ["SKYLIGHT_TOKEN_KEY", "ADMIN_TOKEN", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "ALLOWED_EMAILS"] }
    },
    "production": {
      "name": "skylight-mcp",
      "workers_dev": true,
      "preview_urls": false,
      "durable_objects": {
        "bindings": [{ "name": "SKYLIGHT_ACCOUNT", "class_name": "SkylightAccount" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SkylightAccount"] }],
      "kv_namespaces": [{ "binding": "OAUTH_KV" }],
      "vars": { "SKYLIGHT_TIMEZONE": "America/New_York" },
      "secrets": { "required": ["SKYLIGHT_TOKEN_KEY", "ADMIN_TOKEN", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET", "ALLOWED_EMAILS"] }
    }
  }
}
